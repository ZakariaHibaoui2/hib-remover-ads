{
  "manifest_version": 3,
  "name": "Hib Remover Ads",
  "short_name": "Hib Remover Ads",
  "version": "2.0.5",
  "description": "Ad remover and ad blocker for YouTube and every site. Blocks video ads, popups and trackers. Pause on any site in one click.",
  "minimum_chrome_version": "111",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "scripting",
    "storage",
    "alarms",
    "favicon"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "declarative_net_request": {
    "rule_resources": [
      { "id": "ads", "enabled": true, "path": "rules/ads.json" },
      { "id": "block", "enabled": true, "path": "rules/block.json" },
      { "id": "allow", "enabled": true, "path": "rules/allow.json" }
    ]
  },
  "web_accessible_resources": [
    { "resources": ["redirects/gpt.js"], "matches": ["<all_urls>"], "use_dynamic_url": true },
    { "resources": ["blocked/popup.html", "blocked/popup.js", "blocked/popup.css"], "matches": ["<all_urls>"] }
  ],
  "action": {
    "default_title": "Hib Remover Ads",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/on-16.png",
      "32": "icons/on-32.png"
    }
  },
  "icons": {
    "16": "icons/on-16.png",
    "32": "icons/on-32.png",
    "48": "icons/on-48.png",
    "128": "icons/on-128.png"
  }
}
